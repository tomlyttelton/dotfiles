{
  "layer": "top",
  "position": "bottom",
  "modules-left": [
    "sway/workspaces",
    "sway/mode"
  ],
  "modules-right": [
    "network",
    "cpu",
    "temperature",
    "memory",
    "disk",
    "battery",
    "clock#uk",
    "clock#ca",
    "tray"
  ],
  "sway/workspaces": {
    "format": "{index}:{name}"
  },
  "sway/mode": {
    "format": "{}",
    "tooltip": false
  },
  "network": {
    "interval": 5,
    "format-ethernet": "E: {ipaddr}",
    "format-wifi": "WIFI {essid} ({signalStrength}%)",
    "format-disconnected": "",
    "format-disabled": "",
    "tooltip": false
  },
  "cpu": {
    "interval": 5,
    "format": "CPU {usage}%",
    "states": {
      "warning": 25,
      "critical": 75
    },
    "tooltip": false
  },
  "temperature": {
    "interval": 5,
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input",
    "critical-threshold": 75,
    "format": "T: {temperatureC}°C",
    "format-critical": "T: {temperatureC}°C",
    "tooltip": false
  },
  "memory": {
    "interval": 5,
    "format": "MEM {used:.1f}/{total:.1f}G",
    "states": {
      "warning": 90,
      "critical": 95
    },
    "tooltip": false
  },
  "disk": {
    "interval": 30,
    "path": "/",
    "format": "DISK {free}",
    "states": {
      "warning": 90,
      "critical": 95
    },
    "tooltip": false
  },
  "battery": {
    "interval": 5,
    "states": {
      "warning": 25,
      "critical": 10
    },
    "format": "BAT {capacity}%",
    "format-charging": "BAT CHR {capacity}%",
    "format-discharging": "BAT DIS {capacity}%",
    "format-full": "BAT FULL {capacity}%",
    "tooltip": false
  },
  "clock#uk": {
    "timezone": "Europe/London",
    "format": "{:%Y-%m-%d %H:%M} UK",
    "interval": 10,
    "tooltip": false
  },
  "clock#ca": {
    "timezone": "America/Los_Angeles",
    "format": "{:%Y-%m-%d %H:%M} CA",
    "interval": 10,
    "tooltip": false
  },
  "tray": {
    "spacing": 8
  }
}
